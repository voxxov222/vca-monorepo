# Shared
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vca?schema=public
# Public verify UI origin (Slabook). QR links become {PUBLIC_VERIFY_URL}/verify/qr/:token
PUBLIC_VERIFY_URL=http://localhost:5173

# Slabook (Vite — EXPO_PUBLIC_* kept for Rork parity)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_TOOLKIT_URL=https://toolkit.rork.com
# Trust API base used by public /verify pages
VITE_VCA_API_URL=http://localhost:3001

# API
PORT=3001
SESSION_SECRET=change-me

# --- Live Pokémon pricing / catalog (optional) ---
# Free — higher rate limits on api.pokemontcg.io
POKEMONTCG_API_KEY=
# Paid — graded + loose prices via PriceCharting (also used by tcg-mcp)
PRICECHARTING_TOKEN=
# Free — PSA population / cert lookup for tcg-mcp
PSA_API_TOKEN=
# Local SQLite path for tcg-mcp collection DB
TCG_DB_PATH=/home/box/.tcg-mcp/tcg.db

# Scrydex (Pokémon catalog + raw/graded prices via include=prices)
SCRYDEX_API_KEY=
SCRYDEX_TEAM_ID=
