generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum UserRole {
  CUSTOMER
  GRADER
  ADMIN
}

enum CertificateStatus {
  PENDING
  IN_REVIEW
  CERTIFIED
  VERIFIED
  SUSPENDED
  REVOKED
}

enum SubmissionStatus {
  DRAFT
  RECEIVED
  IN_REVIEW
  GRADING
  AWAITING_APPROVAL
  CERTIFIED
  RETURNED
  CANCELLED
}

enum SlabStatus {
  ASSEMBLY
  ACTIVE
  SUSPENDED
  RETIRED
}

enum VerificationSecurityLevel {
  IDENTIFIER_ONLY
  CRYPTOGRAPHIC
}

enum TamperStatus {
  UNKNOWN
  CLEAR
  SUSPECTED
  TAMPERED
}

model User {
  id                  String                    @id @default(cuid())
  email               String                    @unique
  passwordHash        String
  displayName         String?
  role                UserRole                  @default(CUSTOMER)
  status              UserStatus                @default(ACTIVE)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  sessions            Session[]
  submissions         Submission[]
  auditLogs           AuditLog[]
  certificates        Certificate[]             @relation("CertificateGrader")
  inspectionSessions  InspectionSession[]       @relation("InspectionInspector")
  authoredEvidence    InspectionEvidence[]      @relation("EvidenceAuthor")
  gradeProposals      InspectionGradeProposal[] @relation("GradeProposalAuthor")
  reviewedCardUpdates CardUpdateQueueItem[]     @relation("CardUpdateReviewer")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model CardSet {
  id          String       @id @default(cuid())
  name        String
  brand       String       @default("Pokemon")
  year        Int?
  createdAt   DateTime     @default(now())
  cards       Card[]
  cardMasters CardMaster[]

  @@unique([brand, name, year])
}

model Card {
  id          String       @id @default(cuid())
  setId       String
  name        String
  collectorNo String?
  variant     String?
  language    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  set         CardSet      @relation(fields: [setId], references: [id])
  submissions Submission[]
  cardMaster  CardMaster?

  @@index([name])
  @@index([setId, collectorNo])
}

model Submission {
  id                 String              @id @default(cuid())
  userId             String
  cardId             String?
  status             SubmissionStatus    @default(DRAFT)
  submittedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  user               User                @relation(fields: [userId], references: [id])
  card               Card?               @relation(fields: [cardId], references: [id])
  gradingReports     GradingReport[]
  inspectionSessions InspectionSession[]

  @@index([userId, status])
}

model GradingReport {
  id                 String       @id @default(cuid())
  submissionId       String
  methodologyVersion String
  centering          Decimal?     @db.Decimal(4, 2)
  corners            Decimal?     @db.Decimal(4, 2)
  edges              Decimal?     @db.Decimal(4, 2)
  surface            Decimal?     @db.Decimal(4, 2)
  printQuality       Decimal?     @db.Decimal(4, 2)
  whitening          Decimal?     @db.Decimal(4, 2)
  defects            Json?
  proposedGrade      Decimal?     @db.Decimal(3, 1)
  humanGrade         Decimal?     @db.Decimal(3, 1)
  finalizedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  submission         Submission   @relation(fields: [submissionId], references: [id])
  certificate        Certificate?

  @@index([submissionId, createdAt])
}

model Certificate {
  id                 String              @id @default(cuid())
  gradingReportId    String              @unique
  certificateNo      String              @unique
  serialNo           String              @unique
  status             CertificateStatus   @default(PENDING)
  finalGrade         Decimal?            @db.Decimal(3, 1)
  graderId           String?
  verificationHash   String?             @unique
  certifiedAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  gradingReport      GradingReport       @relation(fields: [gradingReportId], references: [id])
  grader             User?               @relation("CertificateGrader", fields: [graderId], references: [id])
  slab               Slab?
  nfcRecord          NFCRecord?
  qrRecord           QRRecord?
  inspectionSessions InspectionSession[]

  @@index([status])
}

model Slab {
  id                 String              @id @default(cuid())
  certificateId      String              @unique
  status             SlabStatus          @default(ASSEMBLY)
  model              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  certificate        Certificate         @relation(fields: [certificateId], references: [id])
  nfcRecord          NFCRecord?
  inspectionSessions InspectionSession[]
}

model NFCRecord {
  id                 String                    @id @default(cuid())
  certificateId      String                    @unique
  identifier         String                    @unique
  securityLevel      VerificationSecurityLevel @default(IDENTIFIER_ONLY)
  tamperStatus       TamperStatus              @default(UNKNOWN)
  lastVerifiedAt     DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  certificate        Certificate               @relation(fields: [certificateId], references: [id])
  slab               Slab?                     @relation(fields: [slabId], references: [id])
  slabId             String?                   @unique
  inspectionSessions InspectionSession[]

  @@index([certificateId, securityLevel])
}

model QRRecord {
  id             String      @id @default(cuid())
  certificateId  String      @unique
  publicToken    String      @unique
  active         Boolean     @default(true)
  scanCount      Int         @default(0)
  lastVerifiedAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  certificate    Certificate @relation(fields: [certificateId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

// --- Card intelligence foundation (not a catalog ingest) ---
// Null string/number fields mean UNKNOWN. Do not default rarity, finish, or grades.
// vcaCardId is a catalog key, never a certificate serial (those stay on Certificate.serialNo).
// NFC hooks reference NFCRecord only. This schema stores no NFC keys, signatures, or crypto.

enum CardUpdateQueueState {
  NEW
  AUTO_VERIFIED
  NEEDS_REVIEW
  APPROVED
  PUBLISHED
}

/// Assistive authenticity disposition. There is intentionally no CERTAIN value.
enum AuthenticityDisposition {
  INDICATORS
  POTENTIAL_CONCERNS
  REQUIRES_HUMAN_REVIEW
}

enum InspectionCategoryKind {
  CENTERING
  CORNERS
  EDGES
  SURFACE
  PRINT_QUALITY
}

enum InspectionEvidenceKind {
  ORIGINAL_PHOTO
  MEASUREMENT
  MARKER
  NOTE
  REFERENCE_COMPARISON
  ENHANCEMENT
}

model CardMaster {
  id                  String   @id @default(cuid())
  /// Assigned by a future policy. Null until then — never fabricate, never copy a slab serial.
  vcaCardId           String?  @unique
  name                String?
  setName             String?
  cardSetId           String?
  collectorNumber     String?
  language            String?
  rarity              String?
  variant             String?
  finish              String?
  /// Map of field name -> { source, retrievedAt, mode, note }. Missing key = provenance UNKNOWN.
  fieldProvenance     Json?
  /// Optional bridge to the existing trust Card row. Not a second serial.
  legacyCardId        String?  @unique
  /// Pointer to the current published snapshot. Older CardMasterRevision rows stay.
  publishedRevisionId String?  @unique
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  cardSet            CardSet?              @relation(fields: [cardSetId], references: [id], onDelete: SetNull)
  legacyCard         Card?                 @relation(fields: [legacyCardId], references: [id], onDelete: SetNull)
  publishedRevision  CardMasterRevision?   @relation("CardMasterPublished", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  revisions          CardMasterRevision[]  @relation("CardMasterHistory")
  images             CardMasterImage[]
  queueItems         CardUpdateQueueItem[]
  inspectionSessions InspectionSession[]

  @@index([name])
  @@index([setName, collectorNumber])
}

model CardMasterImage {
  id           String     @id @default(cuid())
  cardMasterId String
  url          String
  /// front | back | other — null if the role was not supplied
  role         String?
  sourceLabel  String?
  retrievedAt  DateTime?
  provenance   Json?
  createdAt    DateTime   @default(now())
  cardMaster   CardMaster @relation(fields: [cardMasterId], references: [id], onDelete: Restrict)

  @@index([cardMasterId])
}

/// Append-only snapshot. No updatedAt — publishing inserts a new version.
model CardMasterRevision {
  id           String   @id @default(cuid())
  cardMasterId String
  version      Int
  snapshot     Json
  sourceLabel  String?
  provenance   Json?
  createdAt    DateTime @default(now())
  createdById  String?
  queueItemId  String?  @unique

  cardMaster   CardMaster           @relation("CardMasterHistory", fields: [cardMasterId], references: [id], onDelete: Restrict)
  publishedFor CardMaster?          @relation("CardMasterPublished")
  queueItem    CardUpdateQueueItem? @relation(fields: [queueItemId], references: [id], onDelete: SetNull)

  @@unique([cardMasterId, version])
  @@index([cardMasterId, createdAt])
}

/// One row per proposal version. Supersede by inserting a row; do not rewrite proposedSnapshot.
model CardUpdateQueueItem {
  id               String               @id @default(cuid())
  cardMasterId     String?
  state            CardUpdateQueueState
  proposedSnapshot Json
  sourceLabel      String?
  provenance       Json?
  version          Int
  supersedesId     String?
  createdAt        DateTime             @default(now())
  reviewedAt       DateTime?
  reviewerId       String?

  cardMaster   CardMaster?           @relation(fields: [cardMasterId], references: [id], onDelete: SetNull)
  supersedes   CardUpdateQueueItem?  @relation("CardUpdateVersionChain", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy CardUpdateQueueItem[] @relation("CardUpdateVersionChain")
  reviewer     User?                 @relation("CardUpdateReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  revision     CardMasterRevision?

  @@index([state, createdAt])
  @@index([cardMasterId, version])
}

model InspectionSession {
  id                     String                  @id @default(cuid())
  cardMasterId           String?
  submissionId           String?
  inspectorId            String?
  /// Client build that opened the session. Null = UNKNOWN.
  softwareVersion        String?
  /// Schema migration this API wrote. Not a client claim.
  dbSchemaVersion        String?
  notes                  String?
  startedAt              DateTime                @default(now())
  endedAt                DateTime?
  createdAt              DateTime                @default(now())
  /// Latest assistive proposal. History lives on InspectionGradeProposal. Not a certificate grade.
  proposedGrade          Decimal?                @db.Decimal(3, 1)
  proposedGradeAt        DateTime?
  proposedGradeSource    String?
  inspectorOverrideGrade Decimal?                @db.Decimal(3, 1)
  overrideReason         String?
  overrideAt             DateTime?
  authenticity           AuthenticityDisposition @default(REQUIRES_HUMAN_REVIEW)
  /// Existing Slab.id (digital slab). Does not issue a serial.
  slabId                 String?
  /// Existing NFCRecord.id only. No tag secrets.
  nfcRecordId            String?
  /// Existing Certificate.id. Physical/digital serial stays on Certificate.serialNo.
  certificateId          String?

  cardMaster     CardMaster?               @relation(fields: [cardMasterId], references: [id], onDelete: SetNull)
  submission     Submission?               @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  inspector      User?                     @relation("InspectionInspector", fields: [inspectorId], references: [id], onDelete: SetNull)
  slab           Slab?                     @relation(fields: [slabId], references: [id], onDelete: SetNull)
  nfcRecord      NFCRecord?                @relation(fields: [nfcRecordId], references: [id], onDelete: SetNull)
  certificate    Certificate?              @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  evidence       InspectionEvidence[]
  categoryScores InspectionCategoryScore[]
  gradeProposals InspectionGradeProposal[]

  @@index([cardMasterId, startedAt])
  @@index([inspectorId, startedAt])
}

model InspectionCategoryScore {
  id          String                 @id @default(cuid())
  sessionId   String
  category    InspectionCategoryKind
  /// Null = UNKNOWN. Not zero.
  score       Decimal?               @db.Decimal(4, 2)
  /// Null = UNKNOWN. When set, 0–1.
  confidence  Decimal?               @db.Decimal(4, 3)
  /// Who produced the score (INSPECTOR, ASSISTIVE_AI, MEASUREMENT, …). Null = UNKNOWN.
  sourceLabel String?
  provenance  Json?
  session     InspectionSession      @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, category])
}

/// Append-only. Original photos have no updatedAt and must not be replaced in place.
model InspectionEvidence {
  id              String                 @id @default(cuid())
  sessionId       String
  kind            InspectionEvidenceKind
  /// Original photos and raw measurements stay true. Enhancements are false and point at derivedFromId.
  immutable       Boolean                @default(true)
  originalUrl     String?
  measurement     Json?
  marker          Json?
  note            String?
  softwareVersion String?
  createdAt       DateTime               @default(now())
  createdById     String?
  derivedFromId   String?

  session     InspectionSession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  createdBy   User?                @relation("EvidenceAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  derivedFrom InspectionEvidence?  @relation("EvidenceDerivation", fields: [derivedFromId], references: [id], onDelete: SetNull)
  derivatives InspectionEvidence[] @relation("EvidenceDerivation")

  @@index([sessionId, createdAt])
  @@index([derivedFromId])
}

/// Append-only assistive grade proposals. official certification is a Certificate, never this row.
model InspectionGradeProposal {
  id                     String                  @id @default(cuid())
  sessionId              String
  proposedGrade          Decimal?                @db.Decimal(3, 1)
  proposedGradeSource    String?
  inspectorOverrideGrade Decimal?                @db.Decimal(3, 1)
  overrideReason         String?
  authenticity           AuthenticityDisposition
  categorySnapshot       Json
  createdAt              DateTime                @default(now())
  createdById            String?

  session   InspectionSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  createdBy User?             @relation("GradeProposalAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([sessionId, createdAt])
}
